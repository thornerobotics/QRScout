{
  "$schema": "../schema.json",
  "title": "QRScout",
  "page_title": "REBUILT Match Scouting",
  "sections": [
    {
      "name": "Prematch",
      "fields": [
        {
          "title": "Scouter Initials",
          "type": "text",
          "required": true,
          "preserveDataOnReset": true,
          "code": "scouter"
        },
        {
          "title": "Match Number",
          "type": "number",
          "required": true,
          "code": "matchNumber",
          "preserveDataOnReset": true,
          "autoIncrementOnReset": true
        },
        {
          "title": "Robot",
          "type": "select",
          "required": true,
          "code": "robot",
          "choices": {
            "R1": "Red 1",
            "R2": "Red 2",
            "R3": "Red 3",
            "B1": "Blue 1",
            "B2": "Blue 2",
            "B3": "Blue 3"
          },
          "defaultValue": "R1"
        },
        {
          "title": "Team Number",
          "type": "number",
          "required": true,
          "code": "teamNumber"
        },
        {
          "title": "Set Up Location",
          "type": "select",
          "required": true,
          "code": "setupLoc",
          "choices": {
            "": "",
            "bump": "Bump",
            "trench": "Trench",
            "hub": "Hub",
            "noShow": "No Show"
          },
          "defaultValue": ""
        }
      ]
    },
    {
      "name": "Autonomous",
      "preserveDataOnReset": false,
      "fields": [
        {
          "code": "aBalls",
          "title": "Fuel Scored",
          "type": "counter",
          "defaultValue": 0,
          "min": 0,
          "steps": [1, 2]
        },
        {
          "code": "aLine",
          "title": "Left Starting Line",
          "type": "boolean",
          "defaultValue": false
        },
        {
          "code": "aTower",
          "title": "Tower Scoring",
          "type": "boolean",
          "defaultValue": false
        }
      ]
    },
    {
      "name": "Teleop",
      "preserveDataOnReset": false,
      "fields": [
        {
          "code": "tBalls",
          "title": "Balls Scored",
          "type": "counter",
          "defaultValue": 0,
          "min": 0,
          "required": false,
          "steps": [1, 3, 5]
        },
        {
          "code": "tMiss",
          "title": "Missed Shots",
          "type": "counter",
          "defaultValue": 0,
          "min": 0,
          "required": false,
          "steps": [1, 3, 5]
        },
        {
          "code": "tBump",
          "title": "Travel over Bump",
          "type": "boolean",
          "defaultValue": false,
          "required": false
        },
        {
          "code": "tTrench",
          "title": "Travel over Trench",
          "type": "boolean",
          "defaultValue": false,
          "required": false
        },
        {
          "code": "tTower",
          "title": "Tower Scoring",
          "type": "select",
          "required": false,
          "choices": {
            "None": "None",
            "L1": "L1",
            "L2": "L2",
            "L3": "L3"
          },
          "defaultValue": "None"
        }
      ]
    },
    {
      "name": "Performance",
      "fields": [
        {
          "code": "speed",
          "title": "Robot Speed",
          "type": "rating",
          "defaultValue": 0
        },
        {
          "code": "driver",
          "title": "Driver Skill",
          "type": "rating",
          "defaultValue": 0
        },
        {
          "code": "defense",
          "title": "Defense Prowess",
          "type": "rating",
          "defaultValue": 0
        },
        {
          "code": "stability",
          "title": "Stability",
          "type": "select",
          "choices": {
            "solid": "Solid",
            "tippy": "Tippy",
            "highCOG": "High COG"
          },
          "defaultValue": "solid"
        }
      ]
    },
    {
      "name": "Postmatch",
      "preserveDataOnReset": false,
      "fields": [
        {
          "code": "co",
          "title": "Strategic Comments",
          "type": "text",
          "required": false
        },
        {
          "code": "vibe",
          "title": "Robot Reliability",
          "type": "select",
          "choices": {
            "solid": "Solid",
            "janky": "Janky",
            "dead": "Died on Field"
          },
          "defaultValue": "solid"
        }
      ]
    }
  ]
}
